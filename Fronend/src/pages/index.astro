---
// importar componentes
import Layout from "../layouts/tests/Layout1.astro";
import Hero from "../components/tests/secciones/Hero.astro";

import InfoWithCards from "../components/vrs/v1/secciones/infoWithCards.astro";
import InfoDesarrollo from "../components/tests/infoDesarrollo.astro";
import TextSection from '../components/vrs/v1/secciones/TextSection.astro'
import { object } from "astro:schema";
import StartNowBanner from "../components/vrs/v1/secciones/StartNowBanner.astro";
// 2. Importa las variables directamente desde tu archivo .ts de datos
import { 
  englishCourseTopicsData, 
  englishBenefitsData, 
  englishSimpleData 
} from '../components/data/dataIndex.astro';

---

<Layout titlePage="Easy Englihs">
    <InfoDesarrollo />
    <Hero />
    <!--  Qué aprenderán en el curso -->
    <InfoWithCards {...englishCourseTopicsData} />
    <!--  Beneficios de aprender inglés -->
    <InfoWithCards {...englishBenefitsData} />

    <TextSection {...englishSimpleData} />
    <StartNowBanner></StartNowBanner>
 

</Layout>
