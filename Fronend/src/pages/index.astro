---
import Layout from '../layouts/Layout.astro';

import Seccion from '../components/Seccion.astro';
import Titulo from '../components/Titulo.astro';
import Parrafo from '../components/Parrafo.astro';
---

<Layout title="Easy English - Lección 1">
  
  <Seccion>
    <!-- Título H1 pasando la prop nivel="h1" -->
    <Titulo nivel="h1">
      Easy English: Lección 1
    </Titulo>

    <Parrafo>
      Bienvenido a la primera lección. Hoy aprenderemos a estructurar oraciones sencillas usando el tiempo presente en inglés.
    </Parrafo>

    <!-- Título H2 (por defecto) -->
    <Titulo>
      Regla Esencial
    </Titulo>

    <Parrafo>
      Recuerda que los pronombres en tercera persona (He, She, It) agregan una "s" al final del verbo principal en presente simple.
    </Parrafo>

    <!-- Párrafo destacado pasando la prop destacado -->
    <Parrafo destacado={true}>
      <strong>Tip de estudio:</strong> Practica estas oraciones en voz alta antes de pasar al módulo de ejercicios.
    </Parrafo>
  </Seccion>

</Layout>