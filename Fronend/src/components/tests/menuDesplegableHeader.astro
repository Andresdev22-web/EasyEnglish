
  <div class="relative inline-block text-left" id="dropdown-wrapper">
            <!-- Botón activador con evento onclick -->
            <button
                id="dropdown-btn"
                type="button"
                class="flex items-center gap-2 bg-slate-800 hover:bg-slate-700 text-slate-200 px-3 py-1.5 rounded-lg text-sm font-medium border border-slate-700 transition-colors focus:outline-none focus:ring-2 focus:ring-slate-600"
            >
                <span>Opciones</span>
                <!-- Flecha que rota al abrir -->
                <svg
                    id="dropdown-arrow"
                    class="w-4 h-4 text-slate-400 transition-transform duration-200"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                >
                    <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M19 9l-7 7-7-7"></path>
                </svg>
            </button>

            <!-- Panel Desplegable (Inicia oculto con 'hidden') -->
            <div
                id="dropdown-menu"
                class="absolute right-0 top-full mt-2 w-48 bg-slate-900 border border-slate-800 rounded-xl shadow-2xl p-1.5 z-50 hidden"
            >
                <a
                    href="#perfil"
                    class="flex items-center gap-2 px-3 py-2 text-sm text-slate-300 hover:text-white hover:bg-slate-800 rounded-lg transition-colors"
                >
                    <span>👤</span> Mi Perfil
                </a>

                <a
                    href="#cursos"
                    class="flex items-center gap-2 px-3 py-2 text-sm text-slate-300 hover:text-white hover:bg-slate-800 rounded-lg transition-colors"
                >
                    <span>📚</span> Mis Cursos
                </a>

                <a
                    href="#config"
                    class="flex items-center gap-2 px-3 py-2 text-sm text-slate-300 hover:text-white hover:bg-slate-800 rounded-lg transition-colors"
                >
                    <span>⚙️</span> Configuración
                </a>

                <div class="h-px bg-slate-800 my-1"></div>

                <a
                    href="#logout"
                    class="flex items-center gap-2 px-3 py-2 text-sm text-red-400 hover:bg-red-500/10 rounded-lg transition-colors"
                >
                    <span>🚪</span> Cerrar Sesión
                </a>
            </div>
        </div>

<!-- Script en JavaScript para manejar el clic -->
<script>
  const btn = document.getElementById('dropdown-btn');
  const menu = document.getElementById('dropdown-menu');
  const arrow = document.getElementById('dropdown-arrow');
  const wrapper = document.getElementById('dropdown-wrapper');

  // 1. Abrir / Cerrar al hacer clic en el botón
  btn?.addEventListener('click', (e) => {
    e.stopPropagation();
    menu?.classList.toggle('hidden');
    arrow?.classList.toggle('rotate-180');
  });

  // 2. Cerrar si se hace clic fuera del menú
  document.addEventListener('click', (e) => {
    // Casteamos e.target a Node para que .contains() no marque error
    const targetNode = e.target as Node;

    if (wrapper && !wrapper.contains(targetNode)) {
      menu?.classList.add('hidden');
      arrow?.classList.remove('rotate-180');
    }
  });
</script>
