---
// Importar componentes
import MenuDesplegableHeaderAstroComponent from "./menuDesplegableHeader.astro";
import ThemeSelector from "./ThemeSelector.astro";
---

<div class="fixed top-4 left-0 w-full flex justify-center z-50 px-4">
  <div
    class="bg-[var(--bg-surface)] border border-[var(--border-color)] text-[var(--text-primary)] rounded-xl w-full max-w-5xl h-14 px-4 flex items-center justify-between shadow-lg backdrop-blur-md transition-colors duration-300"
  >
    <!-- Sección Izquierda: Logo + Nombre -->
    <div class="flex items-center gap-3">
      <div
        class="w-9 h-9 rounded-lg overflow-hidden flex-shrink-0 bg-[var(--bg-surface-hover)] border border-[var(--border-color)]"
      >
        <img
          src="/tests/imgTest.png"
          alt="Easy English Logo"
          class="w-full h-full object-cover object-center"
        />
      </div>
      <span class="font-bold text-base tracking-wide text-[var(--text-primary)]">
        Easy English
      </span>
    </div>

    <!-- Sección Derecha: Opciones + Selector de Tema agrupados -->
    <div class="flex items-center gap-2">
      <MenuDesplegableHeaderAstroComponent />
      <ThemeSelector />
    </div>
  </div>
</div>