---
// src/components/Hero.astro
import { Icon } from 'astro-icon/components';
---

<section class="relative min-h-[calc(100vh-5rem)] flex items-center justify-center px-4 overflow-hidden">
  
  <!-- 1. Fondo de resplandor sutil (Glow Effect) detrás del texto -->
  <div 
    class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-72 h-72 sm:w-96 sm:h-96 bg-brand-primary opacity-25 blur-[120px] rounded-full pointer-events-none -z-10 transition-colors duration-500"
  ></div>

  <!-- 2. Contenido principal centrado -->
  <div class="max-w-4xl mx-auto text-center flex flex-col items-center gap-6 z-10">
    
    <!-- Tag / Badge de bienvenida orgánico -->
    <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-brand-primary/10 text-xs font-semibold text-brand-primary shadow-[0_4px_12px_-2px_rgba(0,0,0,0.15)] transition-colors duration-300">
      <Icon name="lucide:sparkles" class="w-3.5 h-3.5 text-brand-primary animate-pulse" />
      <span>Aprende a tu propio ritmo</span>
    </div>

    <!-- Título principal con gradiente -->
    <h1 class="text-5xl sm:text-7xl md:text-8xl font-extrabold tracking-tight text-primary transition-colors duration-300">
      Easy <span class="text-transparent bg-clip-text bg-gradient-to-r from-brand-primary to-brand-secondary">English</span>
    </h1>

    <!-- Descripción pequeña -->
    <p class="text-lg sm:text-xl text-secondary max-w-xl font-normal leading-relaxed transition-colors duration-300">
      Aprende inglés fácil y gratis con lecciones interactivas diseñadas para acelerar tu aprendizaje desde el primer día.
    </p>

    <!-- Botones de Acción (CTAs sin bordes duros) -->
    <div class="flex flex-col sm:flex-row items-center gap-4 mt-2 w-full sm:w-auto">
      <!-- Botón Principal: Empezar gratis -->
      <a 
        href="#empezar" 
        class="w-full sm:w-auto px-8 py-3.5 rounded-2xl bg-brand-primary hover:bg-brand-primary-hover text-primary font-semibold text-base 
               shadow-[0_10px_25px_-5px_rgba(0,0,0,0.3),0_4px_10px_-2px_rgba(0,0,0,0.2)] 
               hover:shadow-[0_15px_30px_-5px_rgba(0,0,0,0.4)] hover:-translate-y-0.5 
               transition-all duration-200 text-center active:scale-95 flex items-center justify-center gap-2"
      >
        <span>Empezar gratis</span>
        <Icon name="lucide:arrow-right" class="w-5 h-5" />
      </a>

      <!-- Botón Secundario: Ver lecciones -->
      <a 
        href="#cursos" 
        class="w-full sm:w-auto px-8 py-3.5 rounded-2xl bg-surface hover:bg-surface-hover text-secondary hover:text-primary font-semibold text-base 
               shadow-[0_8px_20px_-6px_rgba(0,0,0,0.3),0_2px_6px_0_rgba(0,0,0,0.15)] 
               hover:shadow-[0_12px_25px_-5px_rgba(0,0,0,0.4)] hover:-translate-y-0.5 
               transition-all duration-200 text-center flex items-center justify-center gap-2"
      >
        <Icon name="lucide:book-open" class="w-5 h-5 text-brand-primary" />
        <span>Ver lecciones</span>
      </a>
    </div>

  </div>
</section>