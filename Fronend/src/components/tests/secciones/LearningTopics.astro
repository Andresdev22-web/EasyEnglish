---
// src/components/LearningTopics.astro

const topics = [
  {
    category: "Básico",
    title: "Vocabulario Esencial y Gramática Inicial",
    description: "Aprende las palabras del día a día, saludos, verbos fundamentales (como To Be) y cómo estructurar tus primeras oraciones.",
    badgeClass: "bg-emerald-500/15 text-emerald-400",
    icon: "🌱"
  },
  {
    category: "Básico",
    title: "Pronunciación y Escucha (Listening)",
    description: "Entrena tu oído con audios a velocidad nativa guiada y aprende la pronunciación fonética correcta de los sonidos difíciles.",
    badgeClass: "bg-emerald-500/15 text-emerald-400",
    icon: "🎧"
  },
  {
    category: "Intermedio / Avanzado",
    title: "Tiempos Verbales Complejos",
    description: "Domina el Present Perfect, Past Continuous y los condicionales para expresar ideas complejas, hipótesis y experiencias.",
    badgeClass: "bg-brand-primary/15 text-brand-primary",
    icon: "🚀"
  },
  {
    category: "Avanzado",
    title: "Phrasal Verbs y Modismos (Idioms)",
    description: "Habla como un hablante nativo incorporando expresiones cotidianas, modismos y verbos compuestos en tus conversaciones.",
    badgeClass: "bg-brand-secondary/15 text-brand-secondary",
    icon: "🗣️"
  },
  {
    category: "Avanzado",
    title: "Inglés Profesional y Entrevistas",
    description: "Redacción de correos formales, vocabulario de negocios, presentaciones y preparación para entrevistas de trabajo en inglés.",
    badgeClass: "bg-brand-secondary/15 text-brand-secondary",
    icon: "💼"
  },
  {
    category: "Práctica Continua",
    title: "Lectura y Comprensión Real",
    description: "Lee artículos, cuentos adaptados y noticias en inglés con glosarios interactivos que traducen palabras desconocidas al instante.",
    badgeClass: "bg-amber-500/15 text-amber-400",
    icon: "📚"
  }
];
---

<section class="py-16 px-4 max-w-6xl mx-auto">
  
  <!-- Encabezado de la sección -->
  <div class="text-center max-w-2xl mx-auto mb-12 flex flex-col items-center gap-3">
    <h2 class="text-xs font-bold uppercase tracking-widest text-brand-secondary">
      Ruta de Aprendizaje
    </h2>
    <p class="text-3xl sm:text-4xl font-extrabold text-primary transition-colors duration-300">
      Todo lo que vas a dominar
    </p>
    <p class="text-base text-secondary transition-colors duration-300">
      Desde tus primeros pasos con vocabulario básico hasta fluidez avanzada para el mundo profesional.
    </p>
  </div>

  <!-- Grid de Tarjetas Sólidas, Sin Bordes y Flotantes -->
  <div class="grid grid-cols-1 md:grid-cols-[repeat(auto-fit,minmax(280px,1fr))] auto-rows-[minmax(220px,auto)] gap-6">
    {topics.map((item) => (
      <div class="group relative bg-surface rounded-2xl p-6 flex flex-col justify-between shadow-md hover:shadow-xl hover:-translate-y-1 hover:bg-surface-hover transition-all duration-300">
        
        <!-- Parte Superior: Icono + Categoria -->
        <div class="flex flex-col gap-4">
          <div class="flex items-center justify-between">
            <span class="text-2xl p-3 rounded-xl bg-surface-hover group-hover:bg-surface text-primary transition-colors duration-200">
              {item.icon}
            </span>
            <span class={`text-xs font-semibold px-3 py-1 rounded-full ${item.badgeClass}`}>
              {item.category}
            </span>
          </div>

          <!-- Título y Descripción -->
          <div>
            <h3 class="text-lg font-bold text-primary group-hover:text-brand-primary transition-colors duration-200">
              {item.title}
            </h3>
            <p class="text-sm text-secondary mt-2 leading-relaxed transition-colors duration-300">
              {item.description}
            </p>
          </div>
        </div>

        <!-- Indicador inferior estético (sin border-t marcado) -->
        <div class="mt-6 pt-4 border-t border-text-muted/10 flex items-center justify-between text-xs text-muted">
          <span>Módulo interactivo</span>
          <span class="group-hover:translate-x-1.5 transition-transform duration-200 text-brand-primary font-semibold text-sm">→</span>
        </div>

      </div>
    ))}
  </div>

</section>