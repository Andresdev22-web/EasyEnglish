---
import { Icon } from 'astro-icon/components';

interface Benefit {
  title: string;
  description: string;
  icon: string;
  badge: string;
  badgeColor: string;
  highlight?: boolean;
}

const benefits: Benefit[] = [
  {
    title: "Multiplica tus Oportunidades Laborales",
    description: "Accede a vacantes remotas globales en empresas de tecnología, USD/EUR y posiciones de liderazgo sin fronteras geográficas.",
    icon: "lucide:briefcase",
    badge: "Carrera & Ingresos",
    badgeColor: "bg-brand-primary/15 text-brand-primary",
    highlight: true,
  },
  {
    title: "Acceso Total al Conocimiento",
    description: "Más del 50% del contenido de internet, documentación técnica, papers científicos y libros de vanguardia están redactados en inglés.",
    icon: "lucide:book-open-check",
    badge: "Crecimiento Profesional",
    badgeColor: "bg-emerald-500/15 text-emerald-600 dark:text-emerald-400",
  },
  {
    title: "Libertad para Viajar y Conectar",
    description: "Comunícate con confianza en cualquier parte del mundo. Haz amigos internacionales y vive experiencias multiculturales auténticas.",
    icon: "lucide:plane-takeoff",
    badge: "Estilo de Vida",
    badgeColor: "bg-amber-500/15 text-amber-600 dark:text-amber-400",
  },
  {
    title: "Flexibilidad Neuroplástica",
    description: "Aprender un segundo idioma fortalece las conexiones neuronales, retarda el envejecimiento cerebral y mejora la resolución de problemas.",
    icon: "lucide:brain-circuit",
    badge: "Salud Mental",
    badgeColor: "bg-purple-500/15 text-purple-600 dark:text-purple-400",
  },
];
---

<section class="w-full py-16 px-4 md:px-8 bg-surface text-slate-900 dark:text-slate-100 transition-colors duration-300">
  <div class="max-w-7xl mx-mx-auto flex flex-col gap-12">
    
    <!-- Encabezado de Sección -->
    <div class="flex flex-col items-center text-center gap-4 max-w-3xl mx-auto">
      <span class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full text-xs font-semibold bg-brand-primary/15 text-brand-primary tracking-wide uppercase">
        <Icon name="lucide:sparkles" class="w-4 h-4" />
        Transformación Personal
      </span>
      
      <h2 class="text-3xl md:text-5xl font-extrabold tracking-tight leading-tight">
        ¿Por qué dominar el inglés cambiará tu vida?
      </h2>
      
      <p class="text-base md:text-lg text-slate-600 dark:text-slate-400 font-normal leading-relaxed">
        El inglés no es solo un idioma: es la herramienta con mayor retorno de inversión para tu carrera, tu mente y tus aspiraciones globales.
      </p>
    </div>

    <!-- Grid Adaptativo de Tarjetas -->
    <div class="grid grid-cols-1 md:grid-cols-[repeat(auto-fit,minmax(280px,1fr))] auto-rows-[minmax(220px,auto)] gap-6">
      {benefits.map((benefit) => (
        <article class="group relative flex flex-col justify-between p-8 rounded-2xl bg-surface hover:bg-surface-hover shadow-[0_10px_30px_-10px_rgba(0,0,0,0.1),0_2px_8px_0_rgba(0,0,0,0.05)] dark:shadow-[0_10px_30px_-10px_rgba(0,0,0,0.5),0_2px_8px_0_rgba(0,0,0,0.2)] transition-all duration-300 hover:-translate-y-1.5 hover:shadow-[0_20px_40px_-15px_rgba(0,0,0,0.15),0_4px_12px_0_rgba(0,0,0,0.08)] dark:hover:shadow-[0_20px_40px_-15px_rgba(0,0,0,0.7),0_4px_12px_0_rgba(0,0,0,0.3)]">
          
          <div class="flex flex-col gap-5">
            <!-- Fila Superior: Ícono y Badge -->
            <div class="flex items-center justify-between gap-4">
              <div class="p-3.5 rounded-xl bg-brand-primary/10 text-brand-primary group-hover:scale-105 transition-transform duration-300">
                <Icon name={benefit.icon} class="w-6 h-6" />
              </div>
              
              <span class={`px-3 py-1 rounded-full text-xs font-medium ${benefit.badgeColor}`}>
                {benefit.badge}
              </span>
            </div>

            <!-- Contenido Principal -->
            <div class="flex flex-col gap-2">
              <h3 class="text-xl font-bold text-slate-900 dark:text-slate-50 leading-snug">
                {benefit.title}
              </h3>
              <p class="text-sm md:text-base text-slate-600 dark:text-slate-400 font-normal leading-relaxed">
                {benefit.description}
              </p>
            </div>
          </div>

          <!-- Acción / Detalle Inferior -->
          <div class="mt-6 pt-4 flex items-center gap-2 text-xs font-semibold text-brand-primary group-hover:translate-x-1 transition-transform duration-300">
            <span>Saber más</span>
            <Icon name="lucide:arrow-right" class="w-4 h-4" />
          </div>

        </article>
      ))}
    </div>

    <!-- Call To Action Promocional -->
    <div class="mt-4 p-8 md:p-10 rounded-2xl bg-surface bg-gradient-to-r from-brand-primary/10 via-transparent to-purple-500/10 shadow-[0_10px_30px_-10px_rgba(0,0,0,0.1),0_2px_8px_0_rgba(0,0,0,0.05)] dark:shadow-[0_10px_30px_-10px_rgba(0,0,0,0.5),0_2px_8px_0_rgba(0,0,0,0.2)] flex flex-col md:flex-row items-center justify-between gap-6">
      <div class="flex flex-col gap-2 text-center md:text-left">
        <h3 class="text-2xl font-bold text-slate-900 dark:text-slate-50">
          ¿Listo para dar el siguiente paso?
        </h3>
        <p class="text-slate-600 dark:text-slate-400 text-sm md:text-base">
          Comienza hoy mismo con nuestra ruta interactiva y alcanza la fluidez que necesitas.
        </p>
      </div>

      <button class="px-6 py-3.5 rounded-xl font-semibold text-white bg-brand-primary hover:bg-brand-primary/90 shadow-[0_10px_25px_-5px_rgba(0,0,0,0.2)] hover:-translate-y-0.5 active:translate-y-0 transition-all duration-200 flex items-center gap-2 shrink-0 cursor-pointer">
        <span>Empieza Gratis</span>
        <Icon name="lucide:rocket" class="w-5 h-5" />
      </button>
    </div>

  </div>
</section>