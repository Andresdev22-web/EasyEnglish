---
// Permite elegir el nivel H1 o H2 con la prop 'nivel'
const { nivel = "h2" } = Astro.props;
---

{
  nivel === "h1" ? (
    <h1 class="font-heading text-3xl md:text-5xl font-black text-primary tracking-tight my-4">
      <slot />
    </h1>
  ) : (
    <h2 class="font-heading text-xl md:text-2xl font-bold text-secondary tracking-wide my-3 flex items-center gap-2">
      <span class="w-2 h-2 rounded-full bg-secondary inline-block"></span>
      <slot />
    </h2>
  )
}