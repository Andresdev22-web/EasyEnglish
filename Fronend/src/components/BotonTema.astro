---
// src/components/BotonTema.astro
---

<button
  id="theme-toggle"
  type="button"
  aria-label="Cambiar tema"
  class="fixed top-4 right-4 z-50 p-3 rounded-xl bg-bg-surface border border-border-accent text-text-main shadow-lg hover:scale-105 active:scale-95 transition-all cursor-pointer flex items-center justify-center gap-2"
>
  <span id="theme-toggle-icon" class="text-lg">🌙</span>
  <span id="theme-toggle-text" class="text-xs font-bold hidden sm:inline">Modo Oscuro</span>
</button>

<script>
  const toggleBtn = document.getElementById('theme-toggle');
  const icon = document.getElementById('theme-toggle-icon');
  const text = document.getElementById('theme-toggle-text');

  // Función para actualizar los textos e íconos del botón
  function actualizarBoton(esClaro: boolean) {
    if (icon && text) {
      icon.textContent = esClaro ? '☀️' : '🌙';
      text.textContent = esClaro ? 'Modo Claro' : 'Modo Oscuro';
    }
  }

  // Comprobar estado inicial
  const esModoClaro = document.documentElement.classList.contains('light');
  actualizarBoton(esModoClaro);

  // Evento al hacer clic
  toggleBtn?.addEventListener('click', () => {
    const estaEnClaro = document.documentElement.classList.toggle('light');
    localStorage.setItem('theme', estaEnClaro ? 'light' : 'dark');
    actualizarBoton(estaEnClaro);
  });
</script>