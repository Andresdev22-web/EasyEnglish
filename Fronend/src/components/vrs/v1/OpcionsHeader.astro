---
// src/components/menuDesplegableHeader.astro
import { Icon } from 'astro-icon/components';
---

<div class="relative inline-block text-left" id="dropdown-wrapper">
  <!-- Botón activador -->
  <button 
    id="dropdown-btn"
    type="button"
    class="flex items-center gap-2 bg-surface-hover hover:bg-surface-active text-primary px-3.5 py-2 rounded-xl text-sm font-medium transition-all duration-200 shadow-[0_4px_12px_-2px_rgba(0,0,0,0.15)] hover:shadow-[0_6px_16px_-2px_rgba(0,0,0,0.2)] focus:outline-none"
  >
    <span>Opciones</span>
    <Icon 
      name="lucide:chevron-down" 
      id="dropdown-arrow" 
      class="w-4 h-4 text-secondary transition-transform duration-200" 
    />
  </button>

  <!-- Panel Desplegable: Sombra compuesta, sin bordes rígidos y 100% sólido -->
  <div 
    id="dropdown-menu"
    class="absolute right-0 top-full mt-2.5 w-52 bg-surface text-primary rounded-2xl shadow-[0_10px_30px_-10px_rgba(0,0,0,0.5),0_2px_8px_0_rgba(0,0,0,0.2)] p-2 z-50 hidden flex-col gap-1"
  >
    <a 
      href="#perfil" 
      class="flex items-center gap-2.5 px-3 py-2 text-sm font-medium text-secondary hover:text-primary hover:bg-surface-hover rounded-xl transition-colors"
    >
      <Icon name="lucide:user" class="w-4 h-4 text-brand-primary" />
      <span>Mi Perfil</span>
    </a>

    <a 
      href="#cursos" 
      class="flex items-center gap-2.5 px-3 py-2 text-sm font-medium text-secondary hover:text-primary hover:bg-surface-hover rounded-xl transition-colors"
    >
      <Icon name="lucide:book-open" class="w-4 h-4 text-brand-primary" />
      <span>Mis Cursos</span>
    </a>

    <a 
      href="#config" 
      class="flex items-center gap-2.5 px-3 py-2 text-sm font-medium text-secondary hover:text-primary hover:bg-surface-hover rounded-xl transition-colors"
    >
      <Icon name="lucide:settings" class="w-4 h-4 text-brand-primary" />
      <span>Configuración</span>
    </a>

    <!-- Divisor suave sin línea negra rígida -->
    <div class="h-px bg-text-muted/10 my-1 mx-1"></div>

    <a 
      href="#logout" 
      class="flex items-center gap-2.5 px-3 py-2 text-sm text-status-error hover:bg-status-error/10 rounded-xl transition-colors font-medium"
    >
      <Icon name="lucide:log-out" class="w-4 h-4" />
      <span>Cerrar Sesión</span>
    </a>
  </div>
</div>

<script>
  const btn = document.getElementById('dropdown-btn');
  const menu = document.getElementById('dropdown-menu');
  const arrow = document.getElementById('dropdown-arrow');
  const wrapper = document.getElementById('dropdown-wrapper');

  btn?.addEventListener('click', (e) => {
    e.stopPropagation();
    menu?.classList.toggle('hidden');
    menu?.classList.toggle('flex');
    arrow?.classList.toggle('rotate-180');
  });

  document.addEventListener('click', (e) => {
    const targetNode = e.target as Node;
    if (wrapper && !wrapper.contains(targetNode)) {
      menu?.classList.add('hidden');
      menu?.classList.remove('flex');
      arrow?.classList.remove('rotate-180');
    }
  });
</script>