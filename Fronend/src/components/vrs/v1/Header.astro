---
// Importar componentes
import OpcionsHeader from "./OpcionsHeader.astro";
import ThemeSelector from "./ThemeSelector.astro";
import { Icon } from 'astro-icon/components';
---

<div class="fixed top-4 left-0 w-full flex justify-center z-50 px-4">

  <div
    class="bg-surface/90 backdrop-blur-2xl text-primary rounded-2xl w-full max-w-5xl h-14 px-5 flex items-center justify-between shadow-[0_12px_40px_-8px_rgba(0,0,0,0.6),0_0_15px_0_rgba(0,0,0,0.2)] transition-all duration-300"
  >
    <!-- Sección Izquierda: Logo + Nombre -->
    <a href="/" class="flex items-center gap-3.5 group">
      <!-- Icono contenedor sin bordes marcados -->
    <div
  class="w-9 h-9 rounded-xl overflow-hidden flex-shrink-0 bg-surface-hover group-hover:scale-105 transition-transform duration-300 shadow-sm flex items-center justify-center p-1.5 text-brand-primary"
>
  <Icon name="lucide:cloud" class="w-full h-full" />
</div>

      <!-- Nombre con color semántico -->
      <span class="font-extrabold text-base tracking-tight text-primary group-hover:text-brand-primary transition-colors duration-200">
        Easy <span class="text-brand-primary">English</span>
      </span>
    </a>

    <!-- Sección Derecha: Opciones + Selector de Tema -->
    <div class="flex items-center gap-3">
      <OpcionsHeader />
      
      <!-- Separador muy tenue usando opacidad baja en lugar de bordes rígidos -->
      <span class="h-4 w-px bg-text-muted/20"></span>
      
      <ThemeSelector />
    </div>
  </div>
</div>