---
// src/components/SimpleTextSection.astro

export interface TextBlock {
  type: string;
  content: string;
}

export interface Props {
  blocks?: TextBlock[];
}

const { blocks = [] } = Astro.props;
---

<section class="py-16 sm:py-24 px-4 max-w-4xl mx-auto">
  <div class="flex flex-col gap-6">
    {blocks.map((block) => {
      switch (block.type) {
        case 'badge':
          return (
            <div class="pb-2">
              <span class="inline-flex items-center px-4 py-1.5 rounded-full bg-brand-primary/10 text-xs font-semibold text-brand-primary shadow-[0_4px_12px_-2px_rgba(0,0,0,0.15)]">
                {block.content}
              </span>
            </div>
          );

        case 'title':
          return (
            <h1 class="text-3xl sm:text-5xl font-extrabold tracking-tight text-primary leading-tight pb-4">
              {block.content}
            </h1>
          );

        case 'subtitle':
          return (
            <h2 class="text-xl sm:text-2xl font-bold text-primary tracking-tight pt-8">
              {block.content}
            </h2>
          );

        case 'paragraph':
          return (
            <p class="text-base sm:text-lg text-secondary leading-relaxed font-normal">
              {block.content}
            </p>
          );

        default:
          return null;
      }
    })}
  </div>
</section>