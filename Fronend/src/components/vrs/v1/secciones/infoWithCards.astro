---
// src/components/LearningTopics.astro
import { Icon } from 'astro-icon/components';

export interface Topic {
  category: string;
  title: string;
  description: string;
  badgeClass?: string;
  iconName: string;
}

export interface Props {
  sectionTag?: string;
  title?: string;
  description?: string;
  topics?: Topic[];
}

const {
  sectionTag = "Ruta de Aprendizaje",
  title = "Todo lo que vas a dominar",
  description = "Desde tus primeros pasos con vocabulario básico hasta fluidez avanzada para el mundo profesional.",
  topics = [] // Lee las props que le pasas desde fuera
} = Astro.props;
---

<section class="py-16 px-4 max-w-6xl mx-auto">
  
  <!-- Encabezado de la sección -->
  <div class="text-center max-w-2xl mx-auto mb-12 flex flex-col items-center gap-3">
    {sectionTag && (
      <h2 class="text-xs font-bold uppercase tracking-widest text-brand-secondary">
        {sectionTag}
      </h2>
    )}
    <p class="text-3xl sm:text-4xl font-extrabold text-primary transition-colors duration-300">
      {title}
    </p>
    {description && (
      <p class="text-base text-secondary transition-colors duration-300">
        {description}
      </p>
    )}
  </div>

  <!-- Grid de Tarjetas -->
  <div class="grid grid-cols-1 md:grid-cols-[repeat(auto-fit,minmax(280px,1fr))] auto-rows-[minmax(220px,auto)] gap-6">
    {topics.map((item) => (
      <div class="group relative bg-surface rounded-2xl p-6 flex flex-col justify-between 
                  shadow-[0_10px_30px_-10px_rgba(0,0,0,0.5),0_2px_8px_0_rgba(0,0,0,0.2)] 
                  hover:shadow-[0_20px_40px_-15px_rgba(0,0,0,0.7),0_4px_12px_0_rgba(0,0,0,0.3)] 
                  hover:-translate-y-1.5 transition-all duration-300">
        
        <!-- Parte Superior: Ícono + Categoría -->
        <div class="flex flex-col gap-4">
          <div class="flex items-center justify-between">
            <div class="p-3 rounded-xl bg-surface-hover text-brand-primary flex items-center justify-center transition-colors duration-200">
              <Icon name={item.iconName} class="w-6 h-6" />
            </div>
            <span class={`text-xs font-semibold px-3 py-1 rounded-full ${item.badgeClass || 'bg-brand-primary/15 text-brand-primary'}`}>
              {item.category}
            </span>
          </div>

          <!-- Título y Descripción -->
          <div>
            <h3 class="text-lg font-bold text-primary group-hover:text-brand-primary transition-colors duration-200">
              {item.title}
            </h3>
            <p class="text-sm text-secondary mt-2 leading-relaxed transition-colors duration-300">
              {item.description}
            </p>
          </div>
        </div>

        <!-- Indicador inferior -->
        <div class="mt-6 pt-4 border-t border-text-muted/10 flex items-center justify-between text-xs text-muted">
          <span>Módulo interactivo</span>
          <Icon name="lucide:arrow-right" class="w-4 h-4 group-hover:translate-x-1.5 transition-transform duration-200 text-brand-primary font-semibold" />
        </div>

      </div>
    ))}
  </div>

</section>