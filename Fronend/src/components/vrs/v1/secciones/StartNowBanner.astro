---
// src/components/StartNowBanner.astro
import { Icon } from 'astro-icon/components';

export interface Props {
  tag?: string;
  title?: string;
  description?: string;
  startUrl?: string;
  portfolioUrl?: string;
}

const {
  tag = "¿Listo para dar el siguiente paso?",
  title = "Comienza a aprender inglés hoy mismo",
  description = "Accede al contenido organizado, pon a prueba tus conocimientos con exámenes prácticos y avanza a tu propio ritmo.",
  startUrl = "#empezar",
  portfolioUrl = "https://nanadev.online/" // Cambia por tu link real
} = Astro.props;
---

<section class="py-16 px-4 max-w-5xl mx-auto">
  <div class="relative bg-surface rounded-3xl p-8 sm:p-12 md:p-16 text-center flex flex-col items-center gap-6 overflow-hidden
              shadow-[0_15px_35px_-10px_rgba(0,0,0,0.5),0_4px_12px_0_rgba(0,0,0,0.2)]">
    
    <!-- Resplandor sutil de fondo (Glow Effect) -->
    <div 
      class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-64 h-64 sm:w-80 sm:h-80 bg-brand-primary opacity-20 blur-[100px] rounded-full pointer-events-none -z-0"
    ></div>

    <div class="relative z-10 max-w-2xl flex flex-col items-center gap-4">
      
      <!-- Tag / Badge superior -->
      {tag && (
        <span class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-brand-primary/10 text-xs font-semibold text-brand-primary shadow-[0_4px_12px_-2px_rgba(0,0,0,0.15)]">
          <Icon name="lucide:sparkles" class="w-3.5 h-3.5 animate-pulse" />
          <span>{tag}</span>
        </span>
      )}

      <!-- Título Principal -->
      <h2 class="text-3xl sm:text-4xl md:text-5xl font-extrabold text-primary tracking-tight leading-tight">
        {title}
      </h2>

      <!-- Descripción -->
      {description && (
        <p class="text-base sm:text-lg text-secondary leading-relaxed font-normal">
          {description}
        </p>
      )}

      <!-- Botones de Acción -->
      <div class="flex flex-col sm:flex-row items-center gap-4 mt-4 w-full sm:w-auto">
        
        <!-- Botón Principal: Comenzar ahora -->
        <a 
          href={startUrl} 
          class="w-full sm:w-auto px-8 py-3.5 rounded-2xl bg-brand-primary hover:bg-brand-primary-hover text-primary font-semibold text-base 
                 shadow-[0_10px_25px_-5px_rgba(0,0,0,0.3),0_4px_10px_-2px_rgba(0,0,0,0.2)] 
                 hover:shadow-[0_15px_30px_-5px_rgba(0,0,0,0.4)] hover:-translate-y-0.5 
                 transition-all duration-200 text-center active:scale-95 flex items-center justify-center gap-2"
        >
          <span>Comenzar ahora</span>
          <Icon name="lucide:arrow-right" class="w-5 h-5" />
        </a>

        <!-- Botón Secundario: Portafolio del desarrollador -->
        <a 
          href={portfolioUrl} 
          target="_blank"
          rel="noopener noreferrer"
          class="w-full sm:w-auto px-8 py-3.5 rounded-2xl bg-surface-hover hover:bg-surface-active text-secondary hover:text-primary font-semibold text-base 
                 shadow-[0_8px_20px_-6px_rgba(0,0,0,0.3),0_2px_6px_0_rgba(0,0,0,0.15)] 
                 hover:shadow-[0_12px_25px_-5px_rgba(0,0,0,0.4)] hover:-translate-y-0.5 
                 transition-all duration-200 text-center flex items-center justify-center gap-2"
        >
          <Icon name="lucide:code-2" class="w-5 h-5 text-brand-primary" />
          <span>Portafolio del desarrollador</span>
        </a>

      </div>

    </div>

  </div>
</section>